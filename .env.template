# SceneSmith 本地环境变量模板（中文）
#
# 用法：
#   cp .env.template .env
#   编辑 .env
#   set -a && source .env && set +a

# 一、VLM（核心必填）
export SCENESMITH_VLM_API_KEY="YOUR_VLM_API_KEY"
# 可选：OpenAI兼容VLM端点
export SCENESMITH_VLM_BASE_URL="https://api.openai.com/v1"

# 二、图像生成（按后端选）
# 2.1 OpenAI后端
export SCENESMITH_IMAGE_API_KEY="YOUR_IMAGE_API_KEY"
export SCENESMITH_IMAGE_BASE_URL="https://api.openai.com/v1"

# 2.2 Gemini后端（官方或第三方REST）
export SCENESMITH_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# 第三方端点在这里改（示例是官方默认）
export SCENESMITH_GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
# 模型名在这里改
export SCENESMITH_GEMINI_IMAGE_MODEL="gemini-3-pro-image-preview"

# 三、可选
# export LOGLEVEL="INFO"
