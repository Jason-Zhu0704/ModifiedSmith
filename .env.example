# SceneSmith 最小可运行示例（中文说明版）
#
# 这个文件是“最简示例”：
# - 只放最常用变量
# - 适合快速上手
#
# 你可以直接复制为 .env：
#   cp .env.example .env
# 然后把值改成你自己的。

# 核心必填：VLM Key
export SCENESMITH_VLM_API_KEY="sk-..."

# 常用可选：VLM URL（若你使用第三方兼容端点就改这里）
export SCENESMITH_VLM_BASE_URL="https://api.openai.com/v1"

# 如果你启用了 OpenAI 图像生成，再打开下面两行：
# export SCENESMITH_IMAGE_API_KEY="sk-..."
# export SCENESMITH_IMAGE_BASE_URL="https://api.openai.com/v1"

# 如果你启用了 Gemini 图像生成，再打开下面一行：
# export SCENESMITH_GEMINI_API_KEY="AIza..."
# export SCENESMITH_GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
# export SCENESMITH_GEMINI_IMAGE_MODEL="gemini-3-pro-image-preview"
